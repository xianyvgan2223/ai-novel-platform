<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 自动找电脑 / 判断该走 USB 隧道还是局域网时需要看网络状态 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 「一键生成大纲」的后台进度通知：Android 13+ 通知是运行时权限，
         没有它前台服务的通知不会出现在通知栏（用户看不到进度，也点不回来） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务本身：Android 9+ 必须声明 FOREGROUND_SERVICE，
         Android 14+ 还必须按类型声明 FOREGROUND_SERVICE_DATA_SYNC，两者缺一都会在
         startForeground 时抛 SecurityException（App 直接崩） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 「听大纲」后台朗读的前台服务：mediaPlayback 类型。Android 14+ 除了 FOREGROUND_SERVICE
         之外还要按类型声明这条，缺了会在 startForeground(..., MEDIA_PLAYBACK) 时抛
         SecurityException（App 直接崩） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 生成期间持 PARTIAL_WAKE_LOCK：锁屏后 CPU 不休眠，流式请求不会被挂起 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新：允许本 App 调起 APK 安装器（用户仍需在系统里允许「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="deepseekapp"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 「一键生成大纲」的后台生成前台服务：离开页面/切后台/锁屏后继续生成，
             并把进度钉在通知栏，点通知回到 MainActivity 的大纲页。

             foregroundServiceType 必须与 Java 侧 startForeground(..., DATA_SYNC) 以及
             FOREGROUND_SERVICE_DATA_SYNC 权限三者一致，否则 Android 14+ 会拒绝启动。
             stopWithTask=false：用户从最近任务划掉 App 时先回调 onTaskRemoved 把
             「生成中」通知收尾（改成「已中断」），再自己 stopSelf，避免通知栏留假进度。 -->
        <service
            android:name=".OutlineGenerationService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <!-- 「听大纲改名」的后台朗读前台服务：朗读时退回桌面 / 切到别的 App / 锁屏后
             继续逐事件朗读，并把朗读进度 + 播控（上一个事件 / 暂停-继续 / 停止）钉在通知栏，
             点通知主体回到 MainActivity 的朗读页。

             foregroundServiceType=mediaPlayback 必须与 Java 侧
             startForeground(..., FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK) 以及
             FOREGROUND_SERVICE_MEDIA_PLAYBACK 权限三者一致，否则 Android 14+ 会拒绝启动。
             stopWithTask=false：用户从最近任务划掉 App 时先回调 onTaskRemoved，把「正在朗读」
             通知改成「已停止」再 stopSelf（Dart 的逐事件循环已随进程停止），避免留一条假进度。 -->
        <service
            android:name=".OutlineListenService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />
        <!-- 「听大纲」通知栏三个播控按钮的广播接收器：只在本 App 内使用（exported=false），
             PendingIntent 里已经显式指定组件，外部 App 无法伪造播控指令。
             intent-filter 的 action 必须与 OutlineListenService.ACTION_LISTEN 逐字一致。 -->
        <receiver
            android:name=".OutlineListenActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.deepseek.deepseekapp.outline.LISTEN_ACTION" />
            </intent-filter>
        </receiver>
        <!-- 应用内更新：把下载到 files/update/ 下的 APK 通过 content:// 交给系统安装器。
             路径映射见 res/xml/file_paths.xml（external-files-path path="update/"）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 「听大纲改名」用的系统 TTS：Android 11+ 的包可见性限制下，不声明这条
             queries，系统可能看不到已安装的语音引擎，TextToSpeech 初始化直接失败
             （现象：页面提示「本机没有可用的语音引擎」）。 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- 本机没有语音引擎时，页面上的「去商店搜语音引擎」要跳到应用商店的搜索页。
             Android 11+ 的包可见性下，不声明这两条，resolveActivity / startActivity
             会看不到商店（返回 false，按钮变成「没找到商店」）。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mstore"/>
        </intent>
    </queries>
</manifest>
