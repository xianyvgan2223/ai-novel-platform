*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# RAG 语料导出（切块文本、合并稿、打包 zip，属于真实数据）
/rag_export/

# 导入的小说原文（用户数据）
/三国演义.txt

# 调试临时目录与截图证据
/.tmp/
/.dsh_shots/

# 验证报告与 UI 截图基准（本地证据，不入库）
/reports/
/test/ui_shot/shots/

